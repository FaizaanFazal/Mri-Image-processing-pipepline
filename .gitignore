# Generated figures may contain patient-derived anatomy
*.png
*.jpg
*.jpeg
*.tif
*.tiff
*.gif
*.webp
*.svg

# Third-party model weights and templates: download during local setup and
# verify their redistribution terms before publishing them separately.
*.pt
*.pth
*.ckpt
resources/templates/
resources/synthstrip/mri_synthstrip

# Archives can hide ignored data from Git's normal filename checks
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar
